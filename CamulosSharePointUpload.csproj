<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CamulosSharePointUpload</RootNamespace>
    <AssemblyName>CamulosSharePointUpload</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.21.0" />
    <PackageReference Include="Microsoft.SharePointOnline.CSOM" Version="16.1.5521.1200" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="camulosencryption.cs" />
    <Compile Include="configuration.cs" />
    <Compile Include="licensing.cs" />
    <Compile Include="MetadataMigrations.cs" />
    <Compile Include="Migration.cs" />
    <Compile Include="MigrationsDatabase.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
